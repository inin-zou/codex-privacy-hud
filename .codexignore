# Declarative exclusions for consumers that support .codexignore.
# This file is not an access-control boundary.

# Repository metadata and nested worktrees
.git/
.claude/worktrees/

# Local Privacy HUD state
*.db
*.db-wal
*.db-shm
*.sock
ledger.db*
/data/
/.plugin-data/
/receipts/
tests/fixtures/captured/

# Secrets; retain the committed environment example
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
credentials.json
.aws/

# Python artifacts and environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node artifacts
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.next/
out/

# Editor and OS artifacts
.DS_Store
.idea/
.vscode/
*.swp

# Local tooling artifacts
.superpowers/
.gitnexus
