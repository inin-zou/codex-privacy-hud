diff --git a/codex-rs/tui/src/privacy_status.rs b/codex-rs/tui/src/privacy_status.rs
new file mode 100644
index 0000000..cfe7ee6
--- /dev/null
+++ b/codex-rs/tui/src/privacy_status.rs
@@ -0,0 +1,546 @@
+//! `privacy` status-line item: reads the Codex Privacy HUD plugin's snapshot
+//! file (contract A) and renders `Privacy legacy 28% · 2 prevented rows`.
+//!
+//! No subprocess, no network, no config key beyond the item id. Snapshot
+//! version 2 carries an accounting discriminator and nullable quantities;
+//! version 1 is read as explicitly legacy. Every failure — missing file,
+//! stale file, malformed JSON, an unknown version, a field that is missing,
+//! extra, out of range or out of place, `hidden` — renders nothing. The text
+//! is pinned by `privacy_status_reading_golden.json`, a byte copy of the
+//! plugin's `tests/matrix/hud_reading_golden.json`. The numeric bar keeps its
+//! own golden, `privacy_status_golden.json`, a byte copy of
+//! `tests/matrix/hud_golden.json`.
+
+use std::path::PathBuf;
+use std::time::Duration;
+use std::time::Instant;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use serde_json::Map;
+use serde_json::Value;
+
+pub(crate) const SNAPSHOT_VERSION: u64 = 2;
+/// Version 1 snapshots are still read, as legacy accounting.
+pub(crate) const LEGACY_SNAPSHOT_VERSION: u64 = 1;
+/// Mirrors `hud_snapshot.MAX_COUNT`: 2^53 - 1, exact in both readers.
+pub(crate) const MAX_COUNT: u64 = 9_007_199_254_740_991;
+/// Mirrors `hud_snapshot.STALE_AFTER` in the plugin.
+pub(crate) const STALE_AFTER_SECS: f64 = 30.0;
+/// One file read per second at most; the status line repaints far more often.
+pub(crate) const READ_INTERVAL: Duration = Duration::from_secs(1);
+/// `<CODEX_HOME>/plugins/data/<this dir>` is where Codex gives the plugin its `PLUGIN_DATA`.
+const PLUGIN_DATA_DIRNAME: &str = "codex-privacy-hud-codex-privacy-hud";
+
+const V1_KEYS: [&str; 6] = ["v", "percent", "blocked", "unverified", "hidden", "updated_at"];
+const V2_KEYS: [&str; 10] = [
+    "v",
+    "accounting_version",
+    "percent",
+    "confirmed_points",
+    "denials_issued",
+    "legacy_prevented_rows",
+    "unresolved_actions",
+    "unverified",
+    "hidden",
+    "updated_at",
+];
+
+/// One validated reading. The variant is the accounting, so a combination
+/// the snapshot contract does not allow cannot reach rendering.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub(crate) enum PrivacyReading {
+    /// Accounting 0: the ledger has no record of the session. No numbers.
+    Unrecorded,
+    /// Accounting 1: the legacy permitted-crossing score, and a count of
+    /// legacy prevented rows (not denied calls).
+    Legacy {
+        percent: u8,
+        prevented_rows: u64,
+        unverified: bool,
+    },
+    /// Accounting 2, reserved for new accounting. No plugin release writes it
+    /// yet; it is read so a deployed reader can draw it.
+    Evidence {
+        percent: Option<u8>,
+        confirmed_points: f64,
+        denials_issued: u64,
+        unresolved_actions: u64,
+        unverified: bool,
+    },
+}
+
+/// `$PRIVACY_HUD_DATA` (tests, scratch setups) else Codex's plugin-data dir for this plugin.
+pub(crate) fn data_dir() -> Option<PathBuf> {
+    let explicit = std::env::var_os("PRIVACY_HUD_DATA").filter(|dir| !dir.is_empty());
+    if let Some(dir) = explicit {
+        return Some(PathBuf::from(dir));
+    }
+    let home = std::env::var_os("CODEX_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".codex")))?;
+    Some(home.join("plugins").join("data").join(PLUGIN_DATA_DIRNAME))
+}
+
+fn has_exactly(obj: &Map<String, Value>, keys: &[&str]) -> bool {
+    obj.len() == keys.len() && keys.iter().all(|key| obj.contains_key(*key))
+}
+
+/// A JSON integer in `0..=MAX_COUNT`. Booleans and fractions are not counts.
+fn count(value: &Value) -> Option<u64> {
+    value.as_u64().filter(|n| *n <= MAX_COUNT)
+}
+
+fn percent(value: &Value) -> Option<u8> {
+    value.as_u64().filter(|n| *n <= 100).map(|n| n as u8)
+}
+
+/// A finite JSON number. Booleans are not numbers.
+fn number(value: &Value) -> Option<f64> {
+    if !value.is_number() {
+        return None;
+    }
+    value.as_f64().filter(|n| n.is_finite())
+}
+
+/// Contract A to reading. `None` for every failure, including `hidden`.
+pub(crate) fn parse_snapshot(text: &str, now_unix: f64) -> Option<PrivacyReading> {
+    let value: Value = serde_json::from_str(text).ok()?;
+    let obj = value.as_object()?;
+    let version = obj.get("v")?.as_u64()?;
+    let reading = match version {
+        LEGACY_SNAPSHOT_VERSION => parse_v1(obj)?,
+        SNAPSHOT_VERSION => parse_v2(obj)?,
+        _ => return None,
+    };
+    let updated_at = number(obj.get("updated_at")?).filter(|t| *t >= 0.0)?;
+    if obj.get("hidden")?.as_bool()? || now_unix - updated_at > STALE_AFTER_SECS {
+        return None;
+    }
+    Some(reading)
+}
+
+fn parse_v1(obj: &Map<String, Value>) -> Option<PrivacyReading> {
+    if !has_exactly(obj, &V1_KEYS) {
+        return None;
+    }
+    Some(PrivacyReading::Legacy {
+        percent: percent(obj.get("percent")?)?,
+        prevented_rows: count(obj.get("blocked")?)?,
+        unverified: obj.get("unverified")?.as_bool()?,
+    })
+}
+
+fn parse_v2(obj: &Map<String, Value>) -> Option<PrivacyReading> {
+    if !has_exactly(obj, &V2_KEYS) {
+        return None;
+    }
+    let field = |key: &str| obj.get(key);
+    let unverified = field("unverified")?.as_bool()?;
+    let pct = field("percent")?;
+    let points = field("confirmed_points")?;
+    let denials = field("denials_issued")?;
+    let rows = field("legacy_prevented_rows")?;
+    let unresolved = field("unresolved_actions")?;
+    match field("accounting_version")?.as_u64()? {
+        0 => {
+            let all_null = [pct, points, denials, rows, unresolved]
+                .iter()
+                .all(|value| value.is_null());
+            (all_null && unverified).then_some(PrivacyReading::Unrecorded)
+        }
+        1 => {
+            if !(points.is_null() && denials.is_null() && unresolved.is_null()) {
+                return None;
+            }
+            Some(PrivacyReading::Legacy {
+                percent: percent(pct)?,
+                prevented_rows: count(rows)?,
+                unverified,
+            })
+        }
+        2 => {
+            if !rows.is_null() {
+                return None;
+            }
+            let confirmed_points = number(points).filter(|n| *n >= 0.0)?;
+            let denials_issued = count(denials)?;
+            let unresolved_actions = count(unresolved)?;
+            let percent = if pct.is_null() {
+                None
+            } else if unresolved_actions == 0 && !unverified {
+                Some(percent(pct)?)
+            } else {
+                return None;
+            };
+            Some(PrivacyReading::Evidence {
+                percent,
+                confirmed_points,
+                denials_issued,
+                unresolved_actions,
+                unverified,
+            })
+        }
+        _ => None,
+    }
+}
+
+/// `<10-cell bar> <pct right-aligned to 2>%`, byte-identical to the plugin's
+/// `render.hud_core`. The status line no longer draws it; it is kept, with
+/// its rounding golden, for the plugin's numeric primitive.
+#[cfg(test)]
+pub(crate) fn render_bar_core(percent: u8) -> String {
+    // Python's round() is half-to-even; 25 gives 2 cells, 35 gives 4 cells.
+    let filled = ((f64::from(percent) / 10.0).round_ties_even() as usize).min(10);
+    let bar: String = "█".repeat(filled) + &"░".repeat(10 - filled);
+    format!("{bar} {percent:>2}%")
+}
+
+/// The reading after the word `Privacy`, byte-identical to the widest
+/// candidate of the plugin's `render.hud_line`. A legacy percentage is
+/// always labelled `legacy`; an unavailable reading has no number.
+pub(crate) fn render_core(reading: PrivacyReading) -> String {
+    match reading {
+        PrivacyReading::Unrecorded => "—% · No session on record".to_string(),
+        PrivacyReading::Legacy {
+            percent,
+            prevented_rows,
+            unverified,
+        } => {
+            let mut text = format!("legacy {percent}%");
+            if prevented_rows > 0 {
+                let plural = if prevented_rows == 1 { "" } else { "s" };
+                text.push_str(&format!(" · {prevented_rows} prevented row{plural}"));
+            }
+            if unverified {
+                text.push_str(" ⚠unverified");
+            }
+            text
+        }
+        PrivacyReading::Evidence {
+            percent,
+            denials_issued,
+            unresolved_actions,
+            unverified,
+            ..
+        } => {
+            let mut text = match percent {
+                Some(percent) => format!("{percent}%"),
+                None => format!("—% · {unresolved_actions} unresolved"),
+            };
+            text.push_str(&format!(" · {denials_issued} denials issued"));
+            if unverified {
+                text.push_str(" ⚠unverified");
+            }
+            text
+        }
+    }
+}
+
+/// The status-line segment.
+pub(crate) fn render_privacy(reading: PrivacyReading) -> String {
+    format!("Privacy {}", render_core(reading))
+}
+
+/// Throttled reader of the plugin's per-session snapshot file.
+pub(crate) struct PrivacyStatusSource {
+    dir: Option<PathBuf>,
+    last_read: Option<Instant>,
+    /// The thread the cached reading belongs to; a different one bypasses the throttle.
+    last_thread: Option<String>,
+    cached: Option<PrivacyReading>,
+}
+
+impl PrivacyStatusSource {
+    pub(crate) fn new() -> Self {
+        Self::with_data_dir_opt(data_dir())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_data_dir(dir: PathBuf) -> Self {
+        Self::with_data_dir_opt(Some(dir))
+    }
+
+    fn with_data_dir_opt(dir: Option<PathBuf>) -> Self {
+        Self {
+            dir,
+            last_read: None,
+            last_thread: None,
+            cached: None,
+        }
+    }
+
+    /// Whether the next `current` call would hit the disk. Cheap gate for the
+    /// per-frame refresh hook, which must not rebuild the status line every frame.
+    pub(crate) fn is_due(&self) -> bool {
+        self.last_read
+            .is_none_or(|last| last.elapsed() >= READ_INTERVAL)
+    }
+
+    /// The reading to show now. At most one file read per `READ_INTERVAL`.
+    pub(crate) fn current(&mut self, thread_id: Option<&str>) -> Option<PrivacyReading> {
+        self.current_at(thread_id, Instant::now())
+    }
+
+    fn current_at(&mut self, thread_id: Option<&str>, now: Instant) -> Option<PrivacyReading> {
+        // `now` is this call's clock reading, and EVERY path out of here
+        // stamps `last_read` with it -- including the two that answer `None`
+        // without touching the disk. `is_due()` is the gate on the per-frame
+        // refresh hook, so a path that consults the clock without stamping it
+        // leaves `is_due()` permanently true: while there is no usable thread
+        // id (the window between startup and the first thread) the hook would
+        // rebuild and repaint the status line on every single frame.
+        let throttled = self
+            .last_read
+            .is_some_and(|last| now.duration_since(last) < READ_INTERVAL);
+        let Some(thread_id) = thread_id else {
+            return self.forget(now);
+        };
+        if thread_id.is_empty() || thread_id.contains('/') || thread_id.starts_with('.') {
+            return self.forget(now);
+        }
+        // A thread switch must never show the previous session's number, so the
+        // throttle only applies while the id is unchanged.
+        let same_thread = self.last_thread.as_deref() == Some(thread_id);
+        if same_thread && throttled {
+            return self.cached;
+        }
+        self.last_read = Some(now);
+        self.last_thread = Some(thread_id.to_string());
+        let dir = self.dir.as_ref()?;
+        let path = dir.join("hud").join(format!("{thread_id}.json"));
+        let now_unix = SystemTime::now().duration_since(UNIX_EPOCH).ok()?;
+        self.cached = std::fs::read_to_string(path)
+            .ok()
+            .and_then(|text| parse_snapshot(&text, now_unix.as_secs_f64()));
+        self.cached
+    }
+
+    /// Stamp the clock, drop the cache, and answer `None`: there is no thread
+    /// whose reading this could be. Clearing `last_thread` too means the next
+    /// usable id re-reads immediately rather than being throttled against a
+    /// cache that belongs to nobody.
+    fn forget(&mut self, now: Instant) -> Option<PrivacyReading> {
+        self.last_read = Some(now);
+        self.last_thread = None;
+        self.cached = None;
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const GOLDEN: &str = include_str!("privacy_status_golden.json");
+    const READING_GOLDEN: &str = include_str!("privacy_status_reading_golden.json");
+
+    fn legacy(percent: u8, prevented_rows: u64, unverified: bool) -> PrivacyReading {
+        PrivacyReading::Legacy {
+            percent,
+            prevented_rows,
+            unverified,
+        }
+    }
+
+    fn pct(reading: Option<PrivacyReading>) -> Option<u8> {
+        match reading? {
+            PrivacyReading::Legacy { percent, .. } => Some(percent),
+            _ => None,
+        }
+    }
+
+    fn snap(percent: i64, hidden: bool, updated_at: f64) -> String {
+        format!(
+            r#"{{"v":2,"accounting_version":1,"percent":{percent},"confirmed_points":null,"denials_issued":null,"legacy_prevented_rows":1,"unresolved_actions":null,"unverified":false,"hidden":{hidden},"updated_at":{updated_at}}}"#
+        )
+    }
+
+    fn rendered(text: &str, now: f64) -> String {
+        parse_snapshot(text, now)
+            .map(render_privacy)
+            .unwrap_or_default()
+    }
+
+    #[test]
+    fn render_bar_core_matches_every_golden_case() {
+        let cases: Vec<Value> = serde_json::from_str(GOLDEN).unwrap();
+        assert!(cases.len() >= 20);
+        for case in cases {
+            let pct = case["percent"].as_u64().unwrap() as u8;
+            let core = case["core"].as_str().unwrap();
+            assert_eq!(render_bar_core(pct), core, "percent {pct}");
+        }
+    }
+
+    #[test]
+    fn every_reading_golden_case_renders() {
+        let golden: Value = serde_json::from_str(READING_GOLDEN).unwrap();
+        let now = golden["now"].as_f64().unwrap();
+        let cases = golden["cases"].as_object().unwrap();
+        assert!(cases.len() >= 14);
+        for (name, case) in cases {
+            let text = match case.get("text") {
+                Some(text) => text.as_str().unwrap().to_string(),
+                None => serde_json::to_string(&case["snapshot"]).unwrap(),
+            };
+            let expected = case["expected"].as_str().unwrap();
+            assert_eq!(rendered(&text, now), expected, "case {name}");
+        }
+    }
+
+    #[test]
+    fn every_malformed_golden_entry_renders_nothing() {
+        let golden: Value = serde_json::from_str(READING_GOLDEN).unwrap();
+        for doc in golden["malformed"].as_array().unwrap() {
+            let text = serde_json::to_string(doc).unwrap();
+            assert!(parse_snapshot(&text, 1010.0).is_none(), "{text}");
+        }
+        for text in golden["malformed_text"].as_array().unwrap() {
+            let text = text.as_str().unwrap();
+            assert!(parse_snapshot(text, 1010.0).is_none(), "{text}");
+        }
+    }
+
+    #[test]
+    fn the_count_ceiling_matches_the_golden() {
+        let golden: Value = serde_json::from_str(READING_GOLDEN).unwrap();
+        assert_eq!(golden["max_count"].as_u64(), Some(MAX_COUNT));
+    }
+
+    #[test]
+    fn a_v1_snapshot_is_read_as_legacy() {
+        let v1 = r#"{"v":1,"percent":28,"blocked":2,"unverified":false,"hidden":false,"updated_at":1000.0}"#;
+        assert_eq!(parse_snapshot(v1, 1010.0), Some(legacy(28, 2, false)));
+    }
+
+    #[test]
+    fn render_privacy_labels_legacy_and_counts_rows() {
+        assert_eq!(
+            render_privacy(legacy(28, 2, true)),
+            "Privacy legacy 28% · 2 prevented rows ⚠unverified"
+        );
+        assert_eq!(render_privacy(legacy(28, 0, false)), "Privacy legacy 28%");
+        assert_eq!(
+            render_privacy(PrivacyReading::Unrecorded),
+            "Privacy —% · No session on record"
+        );
+    }
+
+    #[test]
+    fn parse_accepts_a_fresh_valid_snapshot() {
+        let parsed = parse_snapshot(&snap(28, false, 1000.0), 1010.0);
+        assert_eq!(parsed, Some(legacy(28, 1, false)));
+    }
+
+    #[test]
+    fn parse_rejects_every_failure_as_none() {
+        assert!(parse_snapshot("", 0.0).is_none());
+        assert!(parse_snapshot("{", 0.0).is_none());
+        assert!(parse_snapshot(&snap(101, false, 1000.0), 1010.0).is_none()); // range
+        assert!(parse_snapshot(&snap(-1, false, 1000.0), 1010.0).is_none()); // range
+        assert!(parse_snapshot(&snap(28, true, 1000.0), 1010.0).is_none()); // hidden
+        assert!(parse_snapshot(&snap(28, false, 1000.0), 1031.0).is_none()); // stale
+        assert!(parse_snapshot(&snap(28, false, 1000.0), 1030.0).is_some());
+        let v3 = snap(28, false, 1000.0).replace(r#""v":2"#, r#""v":3"#);
+        assert!(parse_snapshot(&v3, 1010.0).is_none()); // version
+    }
+
+    #[test]
+    fn source_returns_none_without_a_thread_id_or_file() {
+        let dir = tempfile::tempdir().unwrap();
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        assert!(src.current(None).is_none());
+        assert!(src.current(Some("nope")).is_none());
+    }
+
+    #[test]
+    fn every_path_that_reads_the_clock_also_stamps_it() {
+        // `is_due()` gates the per-frame refresh hook. A path that returns
+        // early without stamping leaves it true forever, so the hook rebuilds
+        // and repaints the status line on every frame for as long as there is
+        // no usable thread id.
+        let dir = data_dir_with(&[(".hidden", 40)]);
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        assert!(src.is_due(), "nothing read yet");
+        assert!(src.current(None).is_none());
+        assert!(!src.is_due(), "current(None) consulted the clock");
+        assert!(src.cached.is_none(), "and cached nothing");
+
+        let mut unsafe_id = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        assert!(unsafe_id.current(Some(".hidden")).is_none());
+        assert!(!unsafe_id.is_due(), "an unsafe id consulted the clock");
+        assert!(unsafe_id.cached.is_none(), "and cached nothing");
+    }
+
+    #[test]
+    fn a_usable_id_after_an_unusable_one_is_not_throttled() {
+        // The flip side of stamping the clock on those paths: the stamp must
+        // not then hide a real reading behind the throttle.
+        let dir = data_dir_with(&[("sid", 63)]);
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        let start = Instant::now();
+        assert!(src.current_at(None, start).is_none());
+        assert_eq!(pct(src.current_at(Some("sid"), start)), Some(63));
+    }
+
+    fn unix_now() -> f64 {
+        let elapsed = SystemTime::now().duration_since(UNIX_EPOCH).unwrap();
+        elapsed.as_secs_f64()
+    }
+
+    /// A data dir holding `hud/<name>.json` for each `(name, percent)` given.
+    fn data_dir_with(files: &[(&str, i64)]) -> tempfile::TempDir {
+        let dir = tempfile::tempdir().unwrap();
+        let hud = dir.path().join("hud");
+        std::fs::create_dir_all(&hud).unwrap();
+        for (name, percent) in files {
+            let path = hud.join(format!("{name}.json"));
+            std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+            std::fs::write(path, snap(*percent, false, unix_now())).unwrap();
+        }
+        dir
+    }
+
+    #[test]
+    fn source_reads_file_and_throttles() {
+        let dir = data_dir_with(&[("sid", 63)]);
+        let hud = dir.path().join("hud");
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        assert_eq!(pct(src.current(Some("sid"))), Some(63));
+        std::fs::write(hud.join("sid.json"), snap(64, false, unix_now())).unwrap();
+        let cached = pct(src.current(Some("sid")));
+        assert_eq!(cached, Some(63), "cached within READ_INTERVAL");
+    }
+
+    #[test]
+    fn source_rereads_once_the_interval_has_passed() {
+        let dir = data_dir_with(&[("sid", 63)]);
+        let hud = dir.path().join("hud");
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        let start = Instant::now();
+        assert_eq!(pct(src.current_at(Some("sid"), start)), Some(63));
+        assert!(!src.is_due(), "a fresh read is not due again yet");
+        std::fs::write(hud.join("sid.json"), snap(64, false, unix_now())).unwrap();
+        let later = src.current_at(Some("sid"), start + READ_INTERVAL);
+        assert_eq!(pct(later), Some(64));
+    }
+
+    #[test]
+    fn source_rereads_immediately_for_a_different_thread() {
+        let dir = data_dir_with(&[("a", 10), ("b", 20)]);
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        assert_eq!(pct(src.current(Some("a"))), Some(10));
+        let switched = pct(src.current(Some("b")));
+        assert_eq!(switched, Some(20), "a thread switch must not reuse the cache");
+    }
+
+    #[test]
+    fn source_rejects_unsafe_thread_ids_even_when_a_file_exists() {
+        let dir = data_dir_with(&[("", 30), (".hidden", 40), ("../x", 50)]);
+        let mut src = PrivacyStatusSource::with_data_dir(dir.path().to_path_buf());
+        assert!(src.current(Some("")).is_none());
+        assert!(src.current(Some(".hidden")).is_none());
+        assert!(src.current(Some("../x")).is_none());
+    }
+}
